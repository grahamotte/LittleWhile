---
import config from "../../../config.json";
import { appStoreId, repoUrl } from "../site";
import "../styles.css";

const { title } = Astro.props as { title?: string };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${config.site.title}` : `${config.site.title}: ${config.site.description}`}</title>
    <meta name="description" content={config.site.description} />
    <meta name="theme-color" content="#f5f0e8" />
    <meta property="og:title" content={config.site.title} />
    <meta property="og:description" content={config.site.description} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="m-0 flex min-h-dvh flex-col">
    <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-5 sm:px-8">
      <a href="/" class="flex items-center gap-2.5 font-serif text-[1.125rem] font-medium no-underline">
        <img src="/icon.png" alt="" width="28" height="28" class="size-7" />
        {config.site.title}
      </a>
      <a href={config.apps.supportUrl} class="text-[0.9375rem] text-ink-2 no-underline hover:text-ink">Support</a>
    </header>
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <footer class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-4 border-t border-line px-6 py-8 text-sm text-ink-2 sm:px-8">
      <span>Free, with no ads or accounts. Open source under the MIT license.</span>
      <nav class="flex gap-6">
        <a href={repoUrl} class="no-underline hover:text-ink">Source</a>
        <a href={config.apps.supportUrl} class="no-underline hover:text-ink">Support</a>
        <a href="/privacy" class="no-underline hover:text-ink">Privacy</a>
      </nav>
    </footer>
  </body>
</html>
